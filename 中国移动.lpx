#!name=Paperclip · 中国移动 Cookie 抓取（精简版）

#!desc=只保留中国移动的 Cookie 抓取（原合集 by MaYIHEI，此为精简版）。打开本插件，重新打开「中国移动」App 并操作一次，收到「✅ 中国移动 Cookie 获取成功」后关掉本插件，避免一直解密这些域名。

#!author=MaYIHEI

#!homepage=https://github.com/MaYIHEI/paperclip/tree/main/loon/paperclip-cookie

#!icon=https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/cmcc.png

#!loon_version = 3.5.1(983)

#!tag=签到, Cookie, 中国移动


[Script]

request if ${url} ~= /^https:\/\/client\.app\.coc\.10086\.cn\/biz-orange\/[LD]N\/uam(onekey|randcode)login\/autoLogin/i then 
script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/cmcc/cmcc.js") with tag="中国移动 Cookie", 
img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/cmcc.png", requires_body=true

request if ${url} ~= /^https:\/\/clientaccess\.10086\.cn\/biz-orange\/BN\/scoreQueryService\/getScoreQuery/i then 
script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/cmcc/cmcc.js") with tag="中国移动 Cookie", 
img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/cmcc.png", requires_body=true

request if ${url} ~= /^https:\/\/h5\.bj\.10086\.cn\/ActSignIn2023\/doPrize/i then 
script("https://raw.githubusercontent.com/MaYIHEI/paperclip/refs/heads/main/app/cmcc/cmcc.js") with tag="中国移动 Cookie", 
img_url="https://raw.githubusercontent.com/MaYIHEI/pin/refs/heads/main/app/cmcc.png"


[MITM]

hostname = client.app.coc.10086.cn, clientaccess.10086.cn, h5.bj.10086.cn